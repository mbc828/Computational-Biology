; npt.mdp — 1 ns NPT 平衡（重原子位置限制）
define      = -DPOSRES -DPOSRES_LIG
integrator  = md
nsteps      = 500000       ; 1 ns @ 2 fs
dt          = 0.002
comm-mode   = Linear
nstcomm     = 100
nstxout     = 5000
nstvout     = 5000
nstenergy   = 1000
nstlog      = 1000
constraints = h-bonds
constraint_algorithm = lincs
lincs_iter  = 1
lincs_order = 4
cutoff-scheme = Verlet
nstlist     = 10
ns_type     = grid
rcoulomb    = 1.0
rvdw        = 1.0
coulombtype = PME
pme_order   = 4
fourierspacing = 0.16
vdw-type    = cutoff
rvdw-switch = 0.9
DispCorr    = EnerPres
tcoupl      = V-rescale
tc-grps     = Protein Non-Protein
tau_t       = 0.1 0.1
ref_t       = 300 300
pcoupl      = C-rescale
pcoupltype  = isotropic
tau_p       = 5.0
ref_p       = 1.0
compressibility = 4.5e-5
pbc         = xyz
gen_vel     = no
continuation = yes
