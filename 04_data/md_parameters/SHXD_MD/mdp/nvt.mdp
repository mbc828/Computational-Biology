; nvt.mdp — 100 ps NVT 平衡（重原子位置限制）
define      = -DPOSRES -DPOSRES_LIG
integrator  = md
nsteps      = 50000        ; 100 ps @ 2 fs
dt          = 0.002
comm-mode   = Linear
nstcomm     = 100
; 输出
nstxout     = 5000
nstvout     = 5000
nstenergy   = 1000
nstlog      = 1000
; 键约束
constraints = h-bonds
constraint_algorithm = lincs
lincs_iter  = 1
lincs_order = 4
; 邻居列表
cutoff-scheme = Verlet
nstlist     = 10
ns_type     = grid
rcoulomb    = 1.0
rvdw        = 1.0
; 静电/范德华
coulombtype = PME
pme_order   = 4
fourierspacing = 0.16
vdw-type    = cutoff
rvdw-switch = 0.9
DispCorr    = EnerPres
; 温度耦合
tcoupl      = V-rescale
tc-grps     = Protein Non-Protein
tau_t       = 0.1 0.1
ref_t       = 300 300
; 压力
pcoupl      = no
pbc         = xyz
gen_vel     = yes
gen_temp    = 300
gen_seed    = -1
