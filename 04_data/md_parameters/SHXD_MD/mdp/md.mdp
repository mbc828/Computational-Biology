; md.mdp — 100 ns 正式模拟（去限制）
integrator  = md
nsteps      = 50000000     ; 100 ns @ 2 fs
dt          = 0.002
comm-mode   = Linear
nstcomm     = 100
; 输出（约每 10 ps 一帧）
nstxout-compressed = 5000
compressed-x-grps  = System
nstenergy   = 5000
nstlog      = 5000
constraints = h-bonds
constraint_algorithm = lincs
lincs_iter  = 1
lincs_order = 4
cutoff-scheme = Verlet
nstlist     = 20
ns_type     = grid
rcoulomb    = 1.0
rvdw        = 1.0
coulombtype = PME
pme_order   = 4
fourierspacing = 0.16
vdw-type    = cutoff
rvdw-switch = 0.9
DispCorr    = EnerPres
tcoupl      = V-rescale
tc-grps     = Protein Non-Protein
tau_t       = 0.1 0.1
ref_t       = 300 300
pcoupl      = C-rescale
pcoupltype  = isotropic
tau_p       = 5.0
ref_p       = 1.0
compressibility = 4.5e-5
pbc         = xyz
gen_vel     = no
continuation = yes
